# vivere admin-panel — Template de Variáveis de Ambiente
#
# SEC-O. Só nomes e descrições seguras — nunca valores reais aqui.
# Copia para .env.development (ou .env.production) e preenche localmente.
# Esses ficheiros nunca devem ser rastreados (ver .gitignore na raiz).
#
# Todas as variáveis VITE_* ficam embutidas no bundle do browser: nunca
# colocar aqui chaves privilegiadas (service_role / sb_secret_).

# URL base da Review API (src/review-api/server.ts).
# Desenvolvimento: http://localhost:3001
VITE_API_BASE_URL=

# URL do projecto Supabase usado para login (https://<ref>.supabase.co).
# Desenvolvimento: SEMPRE o projecto de staging (src/config/environments.ts).
VITE_SUPABASE_URL=

# Chave anon/publishable do MESMO projecto — pública por desenho.
VITE_SUPABASE_ANON_KEY=
