# vivere-engine — Template de Variáveis de Ambiente
#
# SEC-010, Activity 16/26. Lista derivada directamente do código real
# (grep exaustivo de process.env em src/ e scripts/) — não é uma lista
# aspiracional. Nenhum valor real aqui, só nomes e descrições seguras.
#
# Copia para .env e preenche com valores reais. .env nunca deve ser
# rastreado (ver .gitignore).

# ---------------------------------------------------------------
# REQUIRED — núcleo do Engine, falha ruidosamente se ausente
# (src/persistence/client/supabase.ts)
# ---------------------------------------------------------------

# URL do projecto Supabase (https://<ref>.supabase.co)
SUPABASE_URL=

# Chave service_role do projecto Supabase — privilegiada, ignora RLS.
# NUNCA expor a clientes (mobile/browser). Só para uso server-side/CLI.
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------
# REQUIRED — review-api (src/review-api/)
# ---------------------------------------------------------------

# Origem(ns) permitida(s) para CORS em produção. Sem isto definido,
# review-api regista um aviso e aceita apenas localhost (modo
# desenvolvimento) — nunca deixar isto por definir em produção real.
CORS_ORIGIN=

# ---------------------------------------------------------------
# REQUIRED — scripts de coleta Google Places
# (scripts/dry-run-google-places.ts, ingest-google-places.ts,
#  ingest-targeted-venues.ts)
# ---------------------------------------------------------------

GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------
# OPTIONAL — têm valor por omissão sensato no código
# ---------------------------------------------------------------

# Nível de log do pino (src/lib/logger.ts). Omitir = 'info'.
LOG_LEVEL=info

# Porta do servidor review-api (src/review-api/server.ts). Omitir = 3001.
REVIEW_API_PORT=3001

# Ambiente de execução (src/review-api/server.ts). Omitir = 'development'.
NODE_ENV=development

# ---------------------------------------------------------------
# DEVELOPMENT/TEST ONLY — nunca necessárias para operação normal do
# Engine; só para scripts/security-rls-validation.ts (Activity 15/26)
# ---------------------------------------------------------------

# Chave anon do mesmo projecto Supabase — pública por desenho, não é
# segredo, mas o Engine normalmente nunca precisa dela (só o harness
# de teste de segurança).
SUPABASE_ANON_KEY=

# Credenciais de uma conta Supabase Auth dedicada a testes de RLS, SEM
# nenhum papel privilegiado (app_metadata.role deve ficar vazio).
# Nunca reutilizar uma conta real de utilizador.
SECURITY_TEST_USER_EMAIL=
SECURITY_TEST_USER_PASSWORD=

# Credenciais de uma conta Supabase Auth com app_metadata.role='admin'
# — usada só para confirmar que o caminho de administrador continua
# funcional após mudanças de RLS. Usa a conta admin real do projecto.
SECURITY_TEST_ADMIN_EMAIL=
SECURITY_TEST_ADMIN_PASSWORD=
